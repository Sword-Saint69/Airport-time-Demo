    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "framer-motion": "12.23.12",
    "next": "16.4.6",
    "react": "19.2.9",
    "react-dom": "19.2.9"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.17",
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "22.18.1",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "postcss": "8.5.32",
    "tailwindcss": "4.1.13",
    "typescript": "5.9.2",
    "wrangler": "4.161.0"
  },
  "overrides": {
    "motion-dom": "12.23.12",
    "motion-utils": "12.23.6"
  }
